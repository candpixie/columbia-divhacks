# Copy to .env.local and fill in.

# TravelTime (server-side only; never exposed to the browser). Keys: https://account.traveltime.com
TRAVELTIME_APP_ID=
TRAVELTIME_API_KEY=

# Supabase for group rooms (the anon/publishable key is designed to be public).
# Supabase dashboard -> Project Settings -> API. Create the tables with supabase.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
